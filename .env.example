# nastemp-2 secrets — COPY to `.env` and fill in. NEVER commit `.env`.
#   cp .env.example .env && nano .env
# Docker Compose auto-loads `./.env` for ${VAR} interpolation.
# Native systemd: setup.sh copies these into /opt/nastemp/nastemp.env (0600).

# --- TrueNAS (HDD temps) ---
TRUENAS_HOST=192.168.1.10
TRUENAS_API_URL=https://192.168.1.10
TRUENAS_API_KEY=
TRUENAS_USER=admin

# --- MQTT broker (HA telemetry) ---
MQTT_BROKER=192.168.1.5
MQTT_USER=
MQTT_PASSWORD=

# --- ntfy push alerts (topic URL is a bearer secret) ---
NTFY_URL=http://192.168.1.5:8080/nastemp

# --- Admin UI login (REQUIRED, no defaults) ---
ADMIN_USER=admin
ADMIN_PASS=

# --- Remote GUI mode (empty = GUI on Proxmox = local mode) ---
# PROXMOX_HOST=
# PROXMOX_USER=root
# PROXMOX_PORT=22
# PROXMOX_KEY=/root/.ssh/id_ed25519
# PROXMOX_CONFIG=/opt/nastemp/config.yaml

# --- Misc ---
TZ=UTC
